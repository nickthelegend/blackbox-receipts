RECEIPTS_DIR=.blackbox
RECEIPTS_SIGNING_KEY=
WALRUS_PUBLISHER_URL=
# Zetaris SaaS API (Open Agent). API key from the Zetaris Console; Org ID from Zetaris Support/Admin.
ZETARIS_API_KEY=
ZETARIS_ORG_ID=
ZETARIS_BASE_URL=https://api.saas.enterprise.zetaris.com
# Optional: a SELECT the live test runs against your org
ZETARIS_TEST_SQL=
# Meterless Runtime (Open Agent). Local, no hosted key: set the token or the runtime's state dir.
METERLESS_TOKEN=
METERLESS_STATE_DIR=
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# Proxy key directory (default ~/.blackbox, outside the workspace)
BLACKBOX_KEY_DIR=
# Run the proxy in front of any stdio MCP server instead of its built-in tools
BLACKBOX_UPSTREAM=
# Verifiers: pin the proxy public key (PEM) and/or a policy hash other than no-secrets-read/v1
BLACKBOX_PUBLIC_KEY=
BLACKBOX_POLICY_HASH=
# Dashboard API answers loopback hosts only unless this is 1
BLACKBOX_DASHBOARD_ALLOW_REMOTE=
