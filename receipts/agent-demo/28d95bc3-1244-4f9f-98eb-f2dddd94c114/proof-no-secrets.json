{
  "version": 1,
  "property": "no-secrets-read",
  "policy": {
    "id": "no-secrets-read/v2",
    "secretPathGlobs": [
      ".env*",
      "*.pem",
      "*.key",
      "id_rsa",
      "id_ed25519",
      "~/.ssh/**",
      ".ssh/**",
      "~/.aws/**",
      ".aws/**",
      "secrets/**",
      ".blackbox/**",
      "credentials.json",
      ".ssh",
      ".aws",
      ".gnupg",
      ".gnupg/**",
      "secrets",
      ".blackbox",
      ".git/**",
      ".git-credentials",
      ".netrc",
      ".npmrc",
      ".pypirc",
      ".pgpass",
      "*.p12",
      "*.pfx",
      ".docker/config.json",
      ".kube/config"
    ],
    "secretArgPatterns": [
      {
        "name": "private-key-block",
        "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----"
      },
      {
        "name": "aws-access-key-id",
        "pattern": "\\bAKIA[0-9A-Z]{16}\\b"
      },
      {
        "name": "github-token",
        "pattern": "\\bgh[pousr]_[A-Za-z0-9]{36,}\\b"
      },
      {
        "name": "gitlab-token",
        "pattern": "\\bglpat-[A-Za-z0-9_-]{20,}\\b"
      },
      {
        "name": "api-secret-key",
        "pattern": "\\bsk-(?:ant-)?[A-Za-z0-9_-]{20,}\\b"
      },
      {
        "name": "slack-token",
        "pattern": "\\bxox[abprs]-[A-Za-z0-9-]{10,}\\b"
      }
    ]
  },
  "policyHash": "d1e72d1a6c224ff147f946791f04f0e4102e28f75649f3c8839222ff3925517f",
