{
  "name": "blackbox-receipts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "build": "pnpm --filter @blackbox/receipts build && pnpm --filter @blackbox/proxy build && pnpm --filter @blackbox/web build",
    "test": "pnpm --filter @blackbox/receipts test",
    "verify": "pnpm --filter @blackbox/proxy verify",
    "dev": "pnpm --filter @blackbox/web dev"
  },
  "devDependencies": { "typescript": "^5.9.3", "tsx": "^4.20.6", "@types/node": "^22.15.30" }
}
