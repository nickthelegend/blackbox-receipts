{
  "name": "@blackbox/verify",
  "version": "0.1.0",
  "description": "Dependency-light verifier for Blackbox Receipts: chains, seals, property proofs and packs. Runs in Node and in the browser (the library has no node: imports); the blackbox-verify bin checks a pack file from the command line.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "blackbox-verify": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.bin.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nickthelegend/blackbox-receipts",
    "directory": "packages/verify"
  },
  "engines": {
    "node": ">=20"
  }
}
