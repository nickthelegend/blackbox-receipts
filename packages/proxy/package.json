{
  "name": "@blackbox/proxy",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "source": "./src/server.ts",
      "import": "./dist/server.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "source": "./src/store.ts",
      "import": "./dist/store.js"
    },
    "./call": {
      "types": "./dist/call.d.ts",
      "source": "./src/call.ts",
      "import": "./dist/call.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "source": "./src/cli.ts",
      "import": "./dist/cli.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "source": "./src/client.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "cd ../.. && node packages/proxy/dist/server.js",
    "verify": "cd ../.. && node packages/proxy/dist/cli.js verify",
    "prove": "cd ../.. && node packages/proxy/dist/cli.js prove",
    "verify-proof": "cd ../.. && node packages/proxy/dist/cli.js verify-proof",
    "prove-no-secrets": "cd ../.. && node packages/proxy/dist/cli.js prove",
    "tamper": "cd ../.. && node packages/proxy/dist/cli.js tamper",
    "verify-export": "cd ../.. && node packages/proxy/dist/cli.js verify-export"
  },
  "dependencies": {
    "@blackbox/receipts": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "zod": "^4.1.12"
  }
}
